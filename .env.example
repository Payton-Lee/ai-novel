# ============================================================
# LangSmith 追踪配置
# ============================================================
# 每个项目的 trace 分离开
LANGSMITH_PROJECT=langgraph-demo
# 在 https://smith.langchain.com 获取你的 API Key
LANGSMITH_API_KEY=your_langsmith_api_key

# ============================================================
# LLM 提供商 API Key — 按需填入需要的
# ============================================================

# 通义千问 (demo_agent / novel 图默认后端)
# 在 https://dashscope.console.aliyun.com/apiKey 获取
QWEN_KEY=your_qwen_api_key

# DeepSeek (novel 图可选后端, OpenAI 兼容接口)
# 在 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# novel 图默认 LLM 后端配置 (不设置时默认 qwen)
# NOVEL_LLM_PROVIDER=deepseek
# NOVEL_LLM_MODEL=deepseek-v4-flash

# Anthropic Claude (novel 图可选后端)
# 在 https://console.anthropic.com 获取
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI 兼容接口 (novel 图可选后端)
# 在 https://platform.openai.com 获取
OPENAI_API_KEY=your_openai_api_key
# 自定义 base_url (可选, 如代理/中转服务)
OPENAI_BASE_URL=

# 智谱 (可选)
ZHI_PU_KEY=your_zhipu_api_key
